<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

	<_EnvFileContent Condition="Exists('.env')">$([System.IO.File]::ReadAllText('.env'))</_EnvFileContent>
	<_RawGroqKey Condition="'$(_EnvFileContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_EnvFileContent)', '(?m)^GROQ_API_KEY\s*=\s*(.+)$').Groups[1].Value.Trim().Trim('"').Trim("'"))</_RawGroqKey>
	<_RawGroqKey Condition="'$(_RawGroqKey)' == ''">$(GROQ_API_KEY)</_RawGroqKey>
  </PropertyGroup>

	<ItemGroup Condition="'$(_RawGroqKey)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>EmbeddedGroqKey</_Parameter1>
			<_Parameter2>$(_RawGroqKey)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
	<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
  </ItemGroup>

	<ItemGroup>
		<None Update="database\init.sql">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Data\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
