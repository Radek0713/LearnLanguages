<UserControl x:Class="LearnLanguages.Views.Controls.FlashcardsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="880">

    <Border Style="{StaticResource MainCardBorderStyle}" Padding="28,18" Margin="120,20" MaxWidth="780">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Center">
                <TextBlock Text="Nauka: Fiszki" FontSize="24" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TopicInfoText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ProgressText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ProgressBar Width="160" Height="8" Minimum="0" Maximum="{Binding TotalCardsCount}" Value="{Binding CurrentCardNumber}" VerticalAlignment="Center">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{StaticResource CardBorderBrush}" CornerRadius="4">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" Background="{StaticResource PrimaryBlueBrush}" CornerRadius="4" HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </StackPanel>
            </StackPanel>

            <!-- Główna strefa fiszki -->
            <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5"
                    Background="White" Width="350" Height="350" Padding="4">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <TextBlock Text="[Brak grafiki Awersu]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=ImgFront}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Image x:Name="ImgFront" Source="{Binding FrontImage}" Stretch="Uniform">
                            <Image.Clip>
                                <RectangleGeometry Rect="20,35,280,280" RadiusX="20" RadiusY="20"/>
                            </Image.Clip>
                        </Image>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <TextBlock Text="[Brak grafiki Rewersu]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=ImgBack}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Image x:Name="ImgBack" Source="{Binding BackImage}" Stretch="Uniform">
                            <Image.Clip>
                                <RectangleGeometry Rect="20,35,280,280" RadiusX="20" RadiusY="20"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Grid>
            </Border>

            <!-- Przyciski akcji -->
            <Grid Grid.Row="2" Margin="0,14,0,8" HorizontalAlignment="Center">
                <Button Content="Obróć fiszkę"
                        FontSize="16" Height="46" Padding="32,0"
                        Background="CornflowerBlue"
                        Command="{Binding FlipCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseModernButtonStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="Źle"
                            Style="{StaticResource BaseModernButtonStyle}"
                            FontSize="16" Height="46" MinWidth="120"
                            Background="IndianRed" Margin="0,0,20,0"
                            Command="{Binding MarkBadCommand}"/>

                    <Button Content="Dobrze"
                            Style="{StaticResource BaseModernButtonStyle}"
                            FontSize="16" Height="46" MinWidth="120"
                            Background="MediumSeaGreen"
                            Command="{Binding MarkGoodCommand}"/>
                </StackPanel>
            </Grid>

            <Button Grid.Row="3" Content="Wróć" Style="{StaticResource BackButtonStyle}" Height="42" Padding="24,0" HorizontalAlignment="Left" Command="{Binding BackCommand}"/>
        </Grid>
    </Border>
</UserControl>