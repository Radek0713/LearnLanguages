<UserControl x:Class="LearnLanguages.Views.Controls.FlashcardsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="880">

    <Border Style="{StaticResource MainCardBorderStyle}" Padding="28,18" Margin="120,20" MaxWidth="780">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Center">
                <TextBlock Text="Nauka: Fiszki" FontSize="24" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtTopicInfo" Text="Dział • Temat" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtProgress" Text="Karta 1 z 1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ProgressBar x:Name="SessionProgressBar" Width="160" Height="8" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{StaticResource CardBorderBrush}" CornerRadius="4">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" Background="{StaticResource PrimaryBlueBrush}" CornerRadius="4" HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </StackPanel>
            </StackPanel>

            <!-- Główna strefa fiszki (bez zmian w wymiarach i przycinaniu) -->
            <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5"
                    Background="White" Width="350" Height="350" Padding="4">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid x:Name="FlashcardFront" Visibility="Visible">
                        <TextBlock Text="[Brak grafiki Awersu]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=ImgFront}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Image x:Name="ImgFront" Stretch="Uniform">
                            <Image.Clip>
                                <RectangleGeometry Rect="20,35,280,280" RadiusX="20" RadiusY="20"/>
                            </Image.Clip>
                        </Image>
                    </Grid>

                    <Grid x:Name="FlashcardBack" Visibility="Collapsed">
                        <TextBlock Text="[Brak grafiki Rewersu]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=ImgBack}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Image x:Name="ImgBack" Stretch="Uniform">
                            <Image.Clip>
                                <RectangleGeometry Rect="20,35,280,280" RadiusX="20" RadiusY="20"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Grid>
            </Border>

            <!-- Przyciski akcji -->
            <Grid Grid.Row="2" Margin="0,14,0,8" HorizontalAlignment="Center">
                <Button x:Name="BtnFlip" Content="Obróć fiszkę"
                        Style="{StaticResource BaseModernButtonStyle}"
                        FontSize="16" Height="46" Padding="32,0"
                        Background="CornflowerBlue"
                        Click="BtnFlip_Click"/>

                <StackPanel x:Name="EvaluationButtons" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="BtnBad" Content="Źle"
                            Style="{StaticResource BaseModernButtonStyle}"
                            FontSize="16" Height="46" MinWidth="120"
                            Background="IndianRed" Margin="0,0,20,0"
                            Click="BtnBad_Click"/>

                    <Button x:Name="BtnGood" Content="Dobrze"
                            Style="{StaticResource BaseModernButtonStyle}"
                            FontSize="16" Height="46" MinWidth="120"
                            Background="MediumSeaGreen"
                            Click="BtnGood_Click"/>
                </StackPanel>
            </Grid>

            <Button Grid.Row="3" Content="Wróć" Style="{StaticResource BackButtonStyle}" Height="42" Padding="24,0" HorizontalAlignment="Left" Click="Btn_Back_Click"/>
        </Grid>
    </Border>
</UserControl>