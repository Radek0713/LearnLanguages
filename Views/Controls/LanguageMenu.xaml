<UserControl x:Class="LearnLanguages.Views.Controls.LanguageMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LearnLanguages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="141*"/>
            <ColumnDefinition Width="59*"/>
            <ColumnDefinition Width="400*"/>
            <ColumnDefinition Width="200*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="2"
                Style="{StaticResource MainCardBorderStyle}"
                Padding="30,15"
                VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,0,14" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ProfileDisplayName}" 
                               Style="{StaticResource PageTitleTextStyle}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Wybierz sekcję, aby kontynuować naukę" 
                               Style="{StaticResource PageSubtitleTextStyle}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btn_calendar" Style="{StaticResource PrimaryButtonStyle}" Height="52" FontSize="15" Margin="0,8" Command="{Binding OpenCalendarCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Kalendarz" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_topics" Style="{StaticResource PrimaryButtonStyle}" Height="52" FontSize="15" Margin="0,8" Command="{Binding OpenTopicsCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📚" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Tematy" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_flashcards" Style="{StaticResource PrimaryButtonStyle}" Height="52" FontSize="15" Margin="0,8" Command="{Binding OpenFlashcardsCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="💡" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Fiszki" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_tasks" Style="{StaticResource PrimaryButtonStyle}" Height="52" FontSize="15" Margin="0,8" Command="{Binding OpenTasksCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📝" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Zadania" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_back" Content="Wróć" Style="{StaticResource BackButtonStyle}" Height="52" FontSize="15" Margin="0,10,0,0" Command="{Binding BackCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>