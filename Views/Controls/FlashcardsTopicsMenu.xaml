<UserControl x:Class="LearnLanguages.Views.Controls.FlashcardsTopicsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Styl przycisków zbiorczych (niebieski / pomarańczowy) -->
        <Style x:Key="ActionPillButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                BorderThickness="0">
                            <Grid>
                                <Border CornerRadius="12" Opacity="0.12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#94A3B8"/>
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl pojedynczego kafelka tematu -->
        <Style x:Key="TopicCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" 
                                Background="#F8FAFC" 
                                BorderBrush="#E2E8F0" 
                                BorderThickness="1.5" 
                                CornerRadius="14" 
                                Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl przycisku Wróć (spójny z resztą aplikacji) -->
        <Style x:Key="ModernBackButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Tło z gradientem identycznym jak w pozostałych menu -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0.0"/>
                <GradientStop Color="#1E1B4B" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Centralna biała karta -->
        <Border Background="White" 
                CornerRadius="24" 
                Padding="28" 
                Margin="30"
                MaxWidth="720"
                VerticalAlignment="Stretch" 
                HorizontalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Nagłówek -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18" HorizontalAlignment="Center">
                    <TextBlock Text="💡 Powtórki na dziś" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#0F172A" 
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Wybierz konkretny temat lub przerób wszystkie karty naraz" 
                               FontSize="13" 
                               Foreground="#64748B" 
                               FontFamily="Segoe UI"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 2. Szybkie tryby zbiorcze: Wszystkie oraz Tylko zaległe -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnReviewAll" 
                            Grid.Column="0"
                            Style="{StaticResource ActionPillButtonStyle}"
                            Background="#2563EB"
                            Click="BtnReviewAll_Click">
                        <TextBlock x:Name="TxtReviewAll" Text="Powtórz wszystkie (0)" FontFamily="Segoe UI"/>
                    </Button>

                    <Button x:Name="BtnReviewOverdue" 
                            Grid.Column="2"
                            Style="{StaticResource ActionPillButtonStyle}"
                            Background="#EA580C"
                            Click="BtnReviewOverdue_Click">
                        <TextBlock x:Name="TxtReviewOverdue" Text="Tylko zaległe (0)" FontFamily="Segoe UI"/>
                    </Button>
                </Grid>

                <!-- 3. Przewijana lista kafelków tematycznych -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <ItemsControl x:Name="TopicsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TopicCardButtonStyle}" Click="BtnTopicCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lewa strona: Temat i Dział -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TopicName}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold" 
                                                       Foreground="#0F172A" 
                                                       FontFamily="Segoe UI"/>
                                            <TextBlock Text="{Binding CategoryName}" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#64748B" 
                                                       FontFamily="Segoe UI"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Prawa strona: Liczniki (na dziś + zaległe) i strzałka -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Niebieska plakietka: Na dziś -->
                                            <Border Background="#2563EB" CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasToday}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TodayCount, StringFormat='{}{0} na dziś'}" 
                                                           Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI"/>
                                            </Border>

                                            <!-- Pomarańczowa plakietka: Zaległe -->
                                            <Border Background="#EA580C" CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasToday}" Value="True">
                                                                <Setter Property="Margin" Value="6,0,0,0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding OverdueCount, StringFormat='{}{0} zaległych'}" 
                                                           Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI"/>
                                            </Border>

                                            <TextBlock Text="›" 
                                                       FontSize="20" 
                                                       FontWeight="Bold" 
                                                       Foreground="#94A3B8" 
                                                       Margin="12,0,0,0" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. Przycisk Wróć -->
                <Button Grid.Row="3" 
                        Content="Wróć" 
                        Style="{StaticResource ModernBackButtonStyle}" 
                        HorizontalAlignment="Left" 
                        Margin="0,12,0,0" 
                        Click="Btn_Back_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>