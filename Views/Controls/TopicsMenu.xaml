<UserControl x:Class="LearnLanguages.Views.Controls.TopicsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LearnLanguages.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="880">

    <UserControl.Resources>
        <!-- Styl dla przycisku Wróć (spójny z pozostałymi widokami) -->
        <Style x:Key="ModernBackButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nowoczesny cienki ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#CBD5E1" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl pojedynczego elementu na liście Działów (zastępuje systemowy niebieski prostokąt) -->
        <Style x:Key="DepartmentItemStyle" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                                Background="Transparent" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Tło z gradientem identycznym jak w pozostałych menu -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0.0"/>
                <GradientStop Color="#1E1B4B" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Główna biała karta -->
        <Border Background="White" 
                CornerRadius="24" 
                Padding="28" 
                Margin="30">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Nagłówek -->
                    <RowDefinition Height="Auto"/>
                    <!-- Spis wybranych tematów (czy_wybrany = 1) -->
                    <RowDefinition Height="*"/>
                    <!-- Master-Detail: Działy i Tematy -->
                    <RowDefinition Height="Auto"/>
                    <!-- Przycisk Wróć -->
                </Grid.RowDefinitions>

                <!-- 1. Nagłówek -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="📚 Zarządzanie Tematami" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#0F172A" 
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Wybierz dział po lewej stronie i dodaj zestawy słówek do codziennej nauki" 
                               FontSize="13" 
                               Foreground="#64748B" 
                               FontFamily="Segoe UI"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 2. Górny pasek: Aktualnie wybrane tematy do nauki -->
                <Border Grid.Row="1" 
                        Background="#F8FAFC" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Padding="14,10" 
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="TxtSelectedHeader" 
                                   Text="Aktualnie wybrane tematy (0):" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="#475569" 
                                   FontFamily="Segoe UI"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtNoSelectedTopics" 
                                   Text="Nie wybrano jeszcze żadnych tematów do nauki." 
                                   FontSize="13" 
                                   FontStyle="Italic"
                                   Foreground="#94A3B8" 
                                   FontFamily="Segoe UI"
                                   Visibility="Visible"/>

                        <ScrollViewer MaxHeight="74" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SelectedTopicsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" 
                                                BorderBrush="#BFDBFE" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="10,4" 
                                                Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CategoryName}" 
                                                           FontSize="12" 
                                                           Foreground="#64748B" 
                                                           FontFamily="Segoe UI"/>
                                                <TextBlock Text=" • " 
                                                           FontSize="12" 
                                                           Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding TopicName}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#1D4ED8" 
                                                           FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 3. Główna zawartość: Działy (Lewa) i Tematy (Prawa) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEWA STRONA: Lista Działów -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="DZIAŁY" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="#64748B" 
                                   Margin="4,0,0,6"/>

                        <Border Grid.Row="1" 
                                Background="#F8FAFC" 
                                BorderBrush="#E2E8F0" 
                                BorderThickness="1" 
                                CornerRadius="14" 
                                Padding="8">
                            <ListBox x:Name="DepartmentsListBox" 
                                     Background="Transparent"
                                     BorderThickness="0"
                                     DisplayMemberPath="Name"
                                     ItemContainerStyle="{StaticResource DepartmentItemStyle}"
                                     SelectionChanged="DepartmentsListBox_SelectionChanged"/>
                        </Border>
                    </Grid>

                    <!-- PRAWA STRONA: Lista Tematów w wybranym dziale -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="TEMATY W DZIALE" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="#64748B" 
                                   Margin="4,0,0,6"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <ItemsControl x:Name="TopicsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" 
                                                BorderBrush="#E2E8F0" 
                                                BorderThickness="1.2" 
                                                CornerRadius="12" 
                                                Padding="14,10" 
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Nazwa tematu -->
                                                <TextBlock Text="{Binding DisplayName}" 
                                                           FontFamily="Segoe UI" 
                                                           FontSize="14" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#1E293B" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,12,0" 
                                                           TextWrapping="Wrap"/>

                                                <!-- Przycisk "Dodaj do nauki" / "W nauce" -->
                                                <Button Grid.Column="1" 
                                                        Tag="{Binding}" 
                                                        Click="AddTopic_Click" 
                                                        Cursor="Hand" 
                                                        Height="34" 
                                                        MinWidth="122" 
                                                        Padding="12,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content" Value="+ Dodaj do nauki"/>
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                            <Setter Property="Background" Value="#10B981"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                                            <Setter Property="FontSize" Value="12.5"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="BtnBorder" 
                                                                                Background="{TemplateBinding Background}" 
                                                                                CornerRadius="9" 
                                                                                BorderThickness="0">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#059669"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>

                                                            <!-- Wygląd po dodaniu -->
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Content" Value="✓ W nauce"/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 4. Przycisk Wróć -->
                <Button Grid.Row="3" 
                        Content="Wróć" 
                        Style="{StaticResource ModernBackButtonStyle}" 
                        HorizontalAlignment="Left" 
                        Margin="0,14,0,0" 
                        Click="Btn_Back_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>