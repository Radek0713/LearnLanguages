<UserControl x:Class="LearnLanguages.Views.Controls.CalendarMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="850">

    <Border Style="{StaticResource MainCardBorderStyle}" Padding="25" Margin="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Pasek górny: Lewo, Miesiąc/Rok, Prawo -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPrevMonth" Content="&lt; Poprzedni" Style="{StaticResource PrimaryButtonStyle}" Height="38" FontSize="13" Padding="14,0" Width="105" Click="Btn_PrevMonth_Click" Grid.Column="0" HorizontalAlignment="Left"/>

                <TextBlock x:Name="TxtMonthYear" Grid.Column="1" Text="Czerwiec 2026"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Następny &gt;" Style="{StaticResource PrimaryButtonStyle}" Height="38" FontSize="13" Padding="14,0" Width="105" Click="Btn_NextMonth_Click" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Nagłówki dni tygodnia -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                <TextBlock Text="Pon" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Text="Wto" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Text="Śro" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Text="Czw" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Text="Pią" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Text="Sob" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Text="Nie" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center"/>
            </UniformGrid>

            <!-- Siatka dni kalendarza -->
            <ItemsControl x:Name="CalendarItemsControl" Grid.Row="2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Margin="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="{StaticResource SubCardBackgroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="6">
                                <!-- Wyszarzenie dni spoza bieżącego miesiąca -->
                                <Border Background="{StaticResource CardBorderBrush}" CornerRadius="8" Opacity="0.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Grid>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <!-- Niebieski pasek: zaplanowane słówka -->
                                        <Border Background="{StaticResource PrimaryBlueBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWords}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding WordCount, StringFormat='{}{0} słówek'}" Foreground="White" FontWeight="Bold" FontSize="10" FontFamily="Segoe UI"/>
                                        </Border>

                                        <!-- Pomarańczowy pasek: zaległe słówka -->
                                        <Border Background="{StaticResource WarningOrangeBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOverdueWords}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasWords}" Value="True">
                                                            <Setter Property="Margin" Value="0,2,0,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding OverdueCount, StringFormat='{}{0} zaległych'}" Foreground="White" FontWeight="Bold" FontSize="10" FontFamily="Segoe UI"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DayNumber}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Row="3" Content="Wróć" Style="{StaticResource BackButtonStyle}" Height="38" FontSize="13" Width="101" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Btn_Back_Click"/>
        </Grid>
    </Border>
</UserControl>