<UserControl x:Class="LearnLanguages.View.Controls.CalendarMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LearnLanguages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="AliceBlue">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Miesiąc i przyciski nawigacji -->
            <RowDefinition Height="Auto"/>
            <!-- Dni tygodnia (Pon, Wto...) -->
            <RowDefinition Height="*"/>
            <!-- Siatka dni (UniformGrid) -->
            <RowDefinition Height="Auto"/>
            <!-- Przycisk Wróć -->
        </Grid.RowDefinitions>

        <!-- Pasek górny: Lewo, Miesiąc/Rok, Prawo -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content=" &lt; Poprzedni " FontFamily="Georgia" Padding="10,5" Click="Btn_PrevMonth_Click"/>
            <TextBlock x:Name="TxtMonthYear" Grid.Column="1" Text="Czerwiec 2026" 
                       FontSize="24" FontWeight="Bold" Foreground="Black" FontFamily="Georgia"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content=" Następny &gt; " FontFamily="Georgia" Padding="10,5" Click="Btn_NextMonth_Click"/>
        </Grid>

        <!-- Nagłówki dni tygodnia -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,10">
            <TextBlock Text="Pon" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
            <TextBlock Text="Wto" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
            <TextBlock Text="Śro" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
            <TextBlock Text="Czw" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
            <TextBlock Text="Pią" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
            <TextBlock Text="Sob" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
            <TextBlock Text="Nie" FontWeight="Bold" Foreground="IndianRed" HorizontalAlignment="Center"/>
        </UniformGrid>

        <!-- NASZ AUTORSKI KALENDARZ -->
        <ItemsControl x:Name="CalendarItemsControl" Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Siatka 7 kolumn (dni) i 6 wierszy (tygodni) -->
                    <UniformGrid Columns="7" Rows="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Wygląd pojedynczej kratki dnia -->
                    <Border BorderBrush="LightGray" BorderThickness="1" Background="White" Margin="2">
                        <Grid>

                            <!-- Półprzezroczysty szary blok dla dni spoza obecnego miesiąca -->
                            <Border Background="LightGray" Opacity="0.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <!-- Domyślnie ukryte -->
                                        <Style.Triggers>
                                            <!-- Pokaż tylko wtedy, gdy IsCurrentMonth jest False -->
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Zamieniamy StackPanel na Grid -->
                            <Grid Margin="5">

                                <!-- Definiujemy 2 kolumny: lewa (na słówka) zajmie tyle miejsca ile trzeba, prawa (na numer) też -->
                                <!-- Ale dzięki układom 'Left' i 'Right' rozjadą się one na boki komórki kalendarza -->

                                <!-- LEWA STRONA: Kółeczko z liczbą słówek -->
                                <Border Background="Orange" CornerRadius="15" Padding="5,2" 
            HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <!-- Wyrównanie do lewej i do środka w pionie -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWords}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding WordCount, StringFormat='{}{0} słówek'}" 
                   Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>

                                <!-- PRAWA STRONA: Numer dnia -->
                                <TextBlock Text="{Binding DayNumber}" 
               FontWeight="Bold" FontSize="14"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <!-- Wyrównanie do prawej i do środka w pionie -->

                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Przycisk Wróć -->
        <Button Grid.Row="3" Content="Wróć" FontFamily="Georgia" Background="IndianRed" Foreground="White" HorizontalAlignment="Left" Padding="20,10" Margin="10 10" Click="Btn_Back_Click"/>
    </Grid>
</UserControl>