<UserControl x:Class="LearnLanguages.Views.Controls.CalendarMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LearnLanguages"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             Background="#FAF7F2">
    <!-- Spójne, ciepłe kremowe tło -->

    <UserControl.Resources>
        <!-- Styl dla nowoczesnych, jasnych przycisków w kalendarzu -->
        <Style x:Key="ModernCalendarButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Specjalny styl dla przycisku Wróć (wygaszony/szary lub alternatywny) -->
        <Style x:Key="ModernBackButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernCalendarButtonStyle}">
            <Setter Property="Background" Value="#64748B"/>
            <!-- Elegancki szaro-grafitowy -->
            <Setter Property="Width" Value="100"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Miesiąc i przyciski nawigacji -->
            <RowDefinition Height="Auto"/>
            <!-- Dni tygodnia (Pon, Wto...) -->
            <RowDefinition Height="*"/>
            <!-- Siatka dni (UniformGrid) -->
            <RowDefinition Height="Auto"/>
            <!-- Przycisk Wróć -->
        </Grid.RowDefinitions>

        <!-- Pasek górny: Lewo, Miesiąc/Rok, Prawo -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="&lt; Poprzedni" Style="{StaticResource ModernCalendarButtonStyle}" Click="Btn_PrevMonth_Click" Grid.ColumnSpan="2" Margin="0,0,652,0"/>

            <TextBlock x:Name="TxtMonthYear" Grid.Column="1" Text="Czerwiec 2026" 
                       FontSize="22" FontWeight="Bold" Foreground="#1E293B" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Następny &gt;" Style="{StaticResource ModernCalendarButtonStyle}" Click="Btn_NextMonth_Click" Grid.ColumnSpan="2" Margin="652,0,0,0"/>
        </Grid>

        <!-- Nagłówki dni tygodnia -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,10">
            <TextBlock Text="Pon" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="Wto" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="Śro" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="Czw" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="Pią" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="Sob" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="Nie" FontWeight="Bold" Foreground="#EF4444" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center"/>
        </UniformGrid>

        <!-- NASZ AUTORSKI KALENDARZ -->
        <ItemsControl x:Name="CalendarItemsControl" Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Siatka 7 kolumn (dni) i 6 wierszy (tygodni) -->
                    <UniformGrid Columns="7" Rows="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Wygląd pojedynczej kratki dnia z zaokrąglonymi rogami i delikatnym obramowaniem -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" Background="White" CornerRadius="10" Margin="3">
                        <Grid Margin="6">

                            <!-- Półprzezroczysty szary blok dla dni spoza obecnego miesiąca -->
                            <Border Background="#F1F5F9" CornerRadius="8" Opacity="0.7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Grid>
                                <!-- LEWA STRONA: Kółeczko z liczbą słówek -->
                                <Border Background="#3B82F6" CornerRadius="10" Padding="6,3" 
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWords}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding WordCount, StringFormat='{}{0} słówek'}" 
                                               Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI"/>
                                </Border>

                                <!-- PRAWA STRONA: Numer dnia -->
                                <TextBlock Text="{Binding DayNumber}" 
                                           FontWeight="Bold" FontSize="15" Foreground="#334155" FontFamily="Segoe UI"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Przycisk Wróć -->
        <Button Grid.Row="3" Content="Wróć" Style="{StaticResource ModernBackButtonStyle}" 
                HorizontalAlignment="Left" Margin="0,16,0,0" Click="Btn_Back_Click"/>
    </Grid>
</UserControl>