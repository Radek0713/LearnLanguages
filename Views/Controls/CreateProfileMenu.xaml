<UserControl x:Class="LearnLanguages.Views.Controls.CreateProfileMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="850"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Zielony przycisk "Dodaj profil" bazujący na wspólnym szablonie -->
        <Style x:Key="GreenSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessGreenBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessGreenHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nowoczesne pole tekstowe dopasowane do kart aplikacji -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SubCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/>
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1"
                Style="{StaticResource MainCardBorderStyle}"
                Padding="35,32"
                Margin="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch">

            <StackPanel VerticalAlignment="Center">
                <!-- Nagłówek -->
                <StackPanel Margin="0,0,0,24" HorizontalAlignment="Center">
                    <TextBlock Text="👤 Nowy profil"
                               Style="{StaticResource PageTitleTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Wpisz nazwę użytkownika, aby utworzyć profil"
                               Style="{StaticResource PageSubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Etykieta i pole do wpisania nazwy -->
                <TextBlock Text="Nazwa profilu"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="2,0,0,6"/>

                <TextBox x:Name="TxtProfileName"
                        Style="{StaticResource ModernTextBoxStyle}"
                        MaxLength="50"
                        Margin="0,0,0,20"
                        Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SaveProfileCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Content="Dodaj profil"
                        Style="{StaticResource GreenSuccessButtonStyle}"
                        Height="48"
                        FontSize="15"
                        Margin="0,0,0,12"
                        Command="{Binding SaveProfileCommand}"/>

                <Button Content="Wróć"
                        Style="{StaticResource BackButtonStyle}"
                        Height="46"
                        FontSize="15"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>