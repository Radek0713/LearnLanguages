<UserControl x:Class="LearnLanguages.Views.Controls.Profiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="850">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1"
                Style="{StaticResource MainCardBorderStyle}"
                Padding="35,30"
                Margin="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch">

            <StackPanel VerticalAlignment="Center">
                <!-- Nagłówek -->
                <StackPanel Margin="0,0,0,22" HorizontalAlignment="Center">
                    <TextBlock Text="👤 Wybierz profil"
                               Style="{StaticResource PageTitleTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Wybierz konto, aby wczytać postępy"
                               Style="{StaticResource PageSubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Komunikat, gdy nie ma jeszcze żadnego profilu -->
                <TextBlock x:Name="TxtNoProfiles"
                           Text="Brak utworzonych profili. Kliknij „Nowy profil”, aby rozpocząć."
                           FontFamily="Segoe UI"
                           FontSize="13.5"
                           FontStyle="Italic"
                           Foreground="{StaticResource TextLightMutedBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,6,0,18"
                           Visibility="Collapsed"/>

                <!-- Pionowa lista przycisków dla istniejących profili -->
                <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProfilesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Tag="{Binding}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="50"
                                        FontSize="15"
                                        Margin="0,0,0,12"
                                        Click="BtnProfile_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Szary przycisk utworzenia nowego profilu (placeholder) -->
                <Button x:Name="BtnNewProfile"
                        Content="+ Nowy profil"
                        Style="{StaticResource BackButtonStyle}"
                        Height="48"
                        FontSize="15"
                        Margin="0,8,0,0"
                        Click="BtnNewProfile_Click"/>
                <!-- Czerwony przycisk zamknięcia aplikacji -->
                <Button x:Name="BtnExitApp"
                    Content="Zamknij aplikację"
                    Style="{StaticResource BaseModernButtonStyle}"
                    Background="IndianRed"
                    Height="48"
                    FontSize="15"
                    Margin="0,12,0,0"
                    Click="BtnExitApp_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>