<UserControl x:Class="LearnLanguages.Views.Controls.StartMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LearnLanguages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Label Content="Wybierz język do nauki" FontFamily="Georgia"
               Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
               FontSize="16" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="2" Grid.Column="1">
            <Button x:Name="btn_english" Content="Angielski" FontFamily="Georgia"
Background="IndianRed" Foreground="White"
Margin="10 5" Click="Btn_english_Click"/>
            <Button x:Name="btn_german" Content="Niemiecki" FontFamily="Georgia"
Background="DimGray" Foreground="White"
Margin="10 5" Click="Btn_unsupportedLanguage_Click"/>
            <Button x:Name="btn_french" Content="Francuski" FontFamily="Georgia"
Background="Blue" Foreground="White"
Margin="10 5" Click="Btn_unsupportedLanguage_Click"/>
            <Button x:Name="btn_spanish" Content="Hiszpański" FontFamily="Georgia"
Background="Goldenrod" Foreground="White"
Margin="10 5" Click="Btn_unsupportedLanguage_Click"/>
            <Button x:Name="btn_italian" Content="Włoski" FontFamily="Georgia"
Background="green" Foreground="White"
Margin="10 5" Click="Btn_unsupportedLanguage_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
