<UserControl x:Class="LearnLanguages.Views.Controls.StartMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="850">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Główna karta startowa na środku -->
        <Border Grid.Column="1"
                Style="{StaticResource MainCardBorderStyle}"
                Padding="35,40" 
                Margin="30"
                VerticalAlignment="Center" 
                HorizontalAlignment="Stretch">

            <StackPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,0,22" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ProfileDisplayName}" 
                               Style="{StaticResource PageTitleTextStyle}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,6"/>
                </StackPanel>

                <Button x:Name="btn_english" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Height="52"
                        FontSize="16"
                        Command="{Binding StartEnglishCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Ucz się angielskiego" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btn_change_profile"
                        Content="Zmień profil"
                        Style="{StaticResource BackButtonStyle}"
                        Height="48"
                        FontSize="15"
                        Margin="0,34,0,0"
                        Command="{Binding ChangeProfileCommand}">
                </Button>
                <Button x:Name="btn_delete_profile"
                        Content="Usuń profil"
                        Style="{StaticResource BaseModernButtonStyle}"
                        Background="IndianRed"
                        Height="48"
                        FontSize="15"
                        Margin="0,12,0,0"
                        Command="{Binding DeleteProfileCommand}">
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>