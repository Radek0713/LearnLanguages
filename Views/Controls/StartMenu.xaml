<UserControl x:Class="LearnLanguages.Views.Controls.StartMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LearnLanguages"
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Uniwersalny, nowoczesny styl przycisku z animacją (spójny z resztą aplikacji) -->
        <Style x:Key="ModernLanguageButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="14" 
                                BorderThickness="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" CenterX="150" CenterY="26"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="15" ShadowDepth="4" Opacity="0.3"/>
                            </Border.Effect>

                            <Grid>
                                <!-- Delikatny efekt połysku -->
                                <Border CornerRadius="14" Opacity="0.12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Najechanie myszką: rozjaśnienie i delikatne powiększenie -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3B82F6"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" 
                                                             Storyboard.TargetProperty="ScaleX" 
                                                             To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" 
                                                             Storyboard.TargetProperty="ScaleY" 
                                                             To="1.02" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" 
                                                             Storyboard.TargetProperty="ScaleX" 
                                                             To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" 
                                                             Storyboard.TargetProperty="ScaleY" 
                                                             To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Kliknięcie -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" 
                                                             Storyboard.TargetProperty="ScaleX" 
                                                             To="0.98" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" 
                                                             Storyboard.TargetProperty="ScaleY" 
                                                             To="0.98" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" 
                                                             Storyboard.TargetProperty="ScaleX" 
                                                             To="1.0" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale" 
                                                             Storyboard.TargetProperty="ScaleY" 
                                                             To="1.0" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Tło całego okna: Nowoczesny, głęboki gradient granatowo-indygo -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0.0"/>
                <GradientStop Color="#1E1B4B" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Główna karta startowa na środku z głębokim cieniem -->
        <Border Grid.Column="1"
                Background="White" 
                CornerRadius="24" 
                Padding="35,40" 
                Margin="30"
                VerticalAlignment="Center" 
                HorizontalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Wybierz język do nauki" 
                           FontFamily="Segoe UI"
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#0F172A" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Margin="0,0,0,30"/>

                <Button x:Name="btn_english" 
                        Background="#2563EB" 
                        Style="{StaticResource ModernLanguageButtonStyle}" 
                        Click="Btn_english_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Angielski" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>