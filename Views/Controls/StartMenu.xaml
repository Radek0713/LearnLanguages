<UserControl x:Class="LearnLanguages.Views.Controls.StartMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="850">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Główna karta startowa na środku -->
        <Border Grid.Column="1"
                Style="{StaticResource MainCardBorderStyle}"
                Padding="35,40" 
                Margin="30"
                VerticalAlignment="Center" 
                HorizontalAlignment="Stretch">

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Wybierz język do nauki" 
                           Style="{StaticResource PageTitleTextStyle}"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30"/>

                <Button x:Name="btn_english" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Height="52"
                        FontSize="16"
                        Click="Btn_english_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Angielski" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>